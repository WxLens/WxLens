+++ b/src/mbgl/shaders/gl/shader_program_gl.cpp
@@ -14,6 +14,25 @@ namespace mbgl {
 namespace gl {
 
 namespace {
+// MapLibre emits GLES 3.0 shader source on every OpenGL platform. Desktop GL accepts the ES
+// shading language only through GL_ARB_ES3_compatibility - Windows, Linux and Mesa drivers all
+// expose it, Apple's OpenGL does not: macOS caps at 4.1 Core with no ES3 compatibility path. So
+// every shader fails to compile there, ShaderProgramGL::create throws the shader-failed-to-
+// compile error, and that exception escapes QMapLibre::Map::render() into Qt's event loop,
+// which has no handler - std::terminate, SIGABRT, on the very first frame.
+//
+// Emitting desktop GLSL is a supported path upstream, not a hack: gl/prelude.hpp already
+// branches on GL_ES and, for the non-ES case, #defines lowp/mediump/highp away so the shared
+// shader bodies compile unchanged. Only this version directive forced ES.
+//
+// Scoped to Apple deliberately. Windows and Linux compile the ES source today via
+// ARB_ES3_compatibility; switching them would flip the prelude onto its other branch on two
+// platforms that already work, for no benefit.
+#if defined(__APPLE__)
+constexpr const char* glslVersionDirective = "#version 330 core\n";
+#else
+constexpr const char* glslVersionDirective = "#version 300 es\n";
+#endif
 
