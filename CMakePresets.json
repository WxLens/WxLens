{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/external/cmake-conan/conan_provider.cmake",
        "WXLENS_VIRTUAL_ENV": "${sourceDir}/.venv"
      }
    },
    {
      "name": "windows-base",
      "inherits": "base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": ["Windows"]
        }
      }
    },
    {
      "name": "linux-base",
      "inherits": "base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-base",
      "inherits": "base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.11.1/macos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "windows-vs2026-x64-base",
      "inherits": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64"
      }
    },
    {
      "name": "linux-gcc14-base",
      "inherits": "linux-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/opt/Qt/6.11.1/gcc_64"
      },
      "environment": {
        "CC": "gcc-14",
        "CXX": "g++-14"
      }
    },
    {
      "name": "windows-vs2026-x64-debug",
      "inherits": "windows-vs2026-x64-base",
      "displayName": "Windows VS 2026 x64 Debug",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CONAN_HOST_PROFILE": "wxlens-windows_vs2026_x64-debug",
        "CONAN_BUILD_PROFILE": "wxlens-windows_vs2026_x64-debug"
      }
    },
    {
      "name": "windows-vs2026-x64-release",
      "inherits": "windows-vs2026-x64-base",
      "displayName": "Windows VS 2026 x64 Release",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CONAN_HOST_PROFILE": "wxlens-windows_vs2026_x64",
        "CONAN_BUILD_PROFILE": "wxlens-windows_vs2026_x64"
      }
    },
    {
      "name": "linux-gcc14-debug",
      "inherits": "linux-gcc14-base",
      "displayName": "Linux GCC 14 Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CONAN_HOST_PROFILE": "wxlens-linux_gcc-14-debug",
        "CONAN_BUILD_PROFILE": "wxlens-linux_gcc-14-debug"
      }
    },
    {
      "name": "linux-gcc14-release",
      "inherits": "linux-gcc14-base",
      "displayName": "Linux GCC 14 Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CONAN_HOST_PROFILE": "wxlens-linux_gcc-14",
        "CONAN_BUILD_PROFILE": "wxlens-linux_gcc-14"
      }
    },
    {
      "name": "macos-clang18-arm64-release",
      "inherits": "macos-base",
      "displayName": "macOS Clang 18 arm64 Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CONAN_HOST_PROFILE": "wxlens-macos_clang-18_arm64",
        "CONAN_BUILD_PROFILE": "wxlens-macos_clang-18_arm64"
      }
    },
    {
      "name": "macos-clang18-x64-release",
      "inherits": "macos-base",
      "displayName": "macOS Clang 18 x64 Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CONAN_HOST_PROFILE": "wxlens-macos_clang-18_x64",
        "CONAN_BUILD_PROFILE": "wxlens-macos_clang-18_x64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-x64-debug",
      "configurePreset": "windows-vs2026-x64-debug",
      "displayName": "Windows VS 2026 x64 Debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-x64-release",
      "configurePreset": "windows-vs2026-x64-release",
      "displayName": "Windows VS 2026 x64 Release",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc14-debug",
      "configurePreset": "linux-gcc14-debug",
      "displayName": "Linux GCC 14 Debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc14-release",
      "configurePreset": "linux-gcc14-release",
      "displayName": "Linux GCC 14 Release",
      "configuration": "Release"
    },
    {
      "name": "macos-clang18-arm64-release",
      "configurePreset": "macos-clang18-arm64-release",
      "displayName": "macOS Clang 18 arm64 Release",
      "configuration": "Release"
    },
    {
      "name": "macos-clang18-x64-release",
      "configurePreset": "macos-clang18-x64-release",
      "displayName": "macOS Clang 18 x64 Release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2026-x64-debug",
      "configurePreset": "windows-vs2026-x64-debug",
      "displayName": "Windows VS 2026 x64 Debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-x64-release",
      "configurePreset": "windows-vs2026-x64-release",
      "displayName": "Windows VS 2026 x64 Release",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc14-debug",
      "configurePreset": "linux-gcc14-debug",
      "displayName": "Linux GCC 14 Debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc14-release",
      "configurePreset": "linux-gcc14-release",
      "displayName": "Linux GCC 14 Release",
      "configuration": "Release"
    },
    {
      "name": "macos-clang18-arm64-release",
      "configurePreset": "macos-clang18-arm64-release",
      "displayName": "macOS Clang 18 arm64 Release",
      "configuration": "Release"
    },
    {
      "name": "macos-clang18-x64-release",
      "configurePreset": "macos-clang18-x64-release",
      "displayName": "macOS Clang 18 x64 Release",
      "configuration": "Release"
    }
  ]
}
